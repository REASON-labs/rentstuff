# Copy to .env and fill in. Never commit the real .env.
SECRET_KEY=change-me-to-a-long-random-string

# Admin login. In production set ADMIN_PASSWORD_HASH (a werkzeug hash);
# for local dev you can just set ADMIN_PASSWORD and the app will hash it.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme
# NOTE: a werkzeug hash contains '$'. In THIS file (read by docker compose)
# escape each '$' as '$$', or compose will mangle it. In a shell, single-quote it.
# ADMIN_PASSWORD_HASH=

# Where the SQLite file lives (the Docker image overrides this to /data/).
# RENTSTUFF_DB=./instance/rentstuff.sqlite3

# Email (optional). Leave blank to disable sending; the app no-ops cleanly.
# Provider-agnostic layer with a Mailgun backend — set these to enable it.
# MAILGUN_API_KEY=
# MAILGUN_DOMAIN=mg.example.com
# MAIL_FROM=RentStuff <postmaster@mg.example.com>
# ADMIN_EMAIL=you@example.com   # where admin notifications go (Settings can override)

# ---------------------------------------------------------------------------
# Anti-abuse (see the README's "Anti-abuse" section)
# ---------------------------------------------------------------------------
# How many reverse proxies sit in front of the app. Set to 1 behind Traefik —
# at 0 every visitor appears to share the proxy's address, so one spammer
# rate-limits the whole site. Set too high and a client can forge
# X-Forwarded-For and skip the limiter entirely.
TRUSTED_PROXIES=0

# Set to 1 when serving over HTTPS so the session cookie is HTTPS-only.
SECURE_COOKIES=

# Set to 1 to turn away renter addresses on known throwaway-mail domains.
BLOCK_DISPOSABLE_EMAIL=

# Cap on how many notifications any single address can cause us to send per
# day. Stops the reserve form being used to flood a stranger's inbox.
MAIL_PER_ADDRESS_PER_DAY=12

# Refuse to decode images above this pixel count (decompression-bomb guard).
MAX_IMAGE_PIXELS=50000000
